#----------------------------------------------------------------------------------
# LLM Configuration
#----------------------------------------------------------------------------------

# Available providers: GROQ, GEMINI, OPENAI

LLM_PROVIDER=GEMINI
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0

# API Key:  Provide only the key of the LLM_PROVIDE that you selected above 
# if you don't have a key, please check the tutorial for more details

GROQ_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

#Set to 1 to activate LLM, 0 to deactivate it, 2 to randomly switch to a new CC scheme from the available ones (LLM is not used).
LLM_ACTIVATED=1

# Evaluation Interval in seconds for evaluating the CC performance and deciding whether to keep, switch, or generate a new CC scheme.
EVALUATION_INTERVAL=60 

# List of available CC schemes (use "cc -ls" to see the list of available schemes). The LLM will only be allowed to choose from these schemes when deciding to switch to an existing CC scheme. Possible values: cubic,reno,vegas 
AVAILABLE_CC_SCHEMES=cubic,reno,vegas

# Number of attempts to request the LLM to provide a valid decision. If after these attempts the LLM response is not satisfactory (bad format, unidentified decision, or CC algorithm not working, the curernt CC algorithm will be kept.

LLM_ATTEMPTS=3 

