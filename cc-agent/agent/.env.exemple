# If you do not already have an API key, you can create one from one of the following providers:")
# - Groq:          https://console.groq.com/keys      
# - OpenAI:       https://platform.openai.com/api-keys  
# - Google Gemini:https://aistudio.google.com/app/apikey  
# 
# Once you have the key, please fill the variables below and save the file. 
# You can also modify the LLM provider, model, and temperature.

#----------------------------------------------------------------------------------
# LLM Configuration
#----------------------------------------------------------------------------------

#Set to 1 to activate LLM, 0 to deactivate, 2 to randomly switch to a new CC scheme from the available ones.
LLM_ACTIVATED=1

# Evaluation Interval in seconds for evaluating the CC performance and deciding whether to keep, switch, or generate a new CC scheme.
EVALUATION_INTERVAL=60 

# List of available CC schemes (use "cc -ls" to see the list of available schemes). The LLM will only be allowed to choose from these schemes when deciding to switch to an existing CC scheme.
# cubic,bbr,reno,vegas 
AVAILABLE_CC_SCHEMES=cubic,reno,vegas

# Number of attempts to generate a valid CC algorithm before giving up
LLM_ATTEMPTS=3 

# Available providers: GROQ, GEMINI, OPENAI
LLM_PROVIDER=GEMINI
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0

# API Keys 
GROQ_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here