#!/bin/bash

# ==========================================================
# FlexNGIA Congestion Control Manager
# ==========================================================
#
# Commands:
#
#   cc
#       Show current active congestion control
#
#   cc -ls
#       List congestion control modules
#
#   sudo cc -s <cc>
#       Load congestion control module — if source is from traces/, prompts
#       for a rename before copying to repo/, compiling, and loading
#
#   cc -a <cc>
#       Activate congestion control
#
#   sudo cc -r <old> <new>
#       Rename a module (copies to repo, renames internals, original untouched)
#
#   cc -u <cc>
#       Unload LLM congestion control module (rmmod + remove compiled files, keep .c)
#
#   cc -l
#       Print all available CC in one space-separated line
#       (union of repo/*.ko names and sysctl list, proxy excluded)
#
# ==========================================================


# ----------------------------------------------------------
# Paths
# ----------------------------------------------------------

CC_PATH="/sys/module/tcp_proxy/parameters/delegate_cc"

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

TRACES_DIR="$SCRIPT_DIR/agent/traces"
REPO_DIR="$TRACES_DIR/repo"

mkdir -p "$REPO_DIR"


# ----------------------------------------------------------
# Helpers
# ----------------------------------------------------------

is_kernel_loaded() {
    sysctl -n net.ipv4.tcp_available_congestion_control \
        | grep -qw "$1"
}

is_builtin() {
    local name="$1"
    # Either a .ko or a .c in repo/ marks the module as LLM-managed
    [ -f "$REPO_DIR/$name.ko" ] && return 1
    [ -f "$REPO_DIR/$name.c"  ] && return 1
    sysctl -n net.ipv4.tcp_available_congestion_control \
        | grep -qw "$name"
}

is_llm() {
    local name="$1"
    [ -f "$REPO_DIR/$name.ko" ] && return 0
    find "$TRACES_DIR" -type f -name "$name.c" ! -name "*.mod.c" \
        -not -path "$REPO_DIR/*.mod.c" \
        | grep -q . && return 0
    return 1
}

get_active_cc() {
    tr -d '[:space:]' < "$CC_PATH" 2>/dev/null
}


# ----------------------------------------------------------
# Show active CC (default, no args)
# ----------------------------------------------------------

show_current_cc() {

    if [ -f "$CC_PATH" ]; then
        current_cc=$(get_active_cc)
        if [ -z "$current_cc" ]; then
            echo "No congestion control is currently active."
        else
            echo "Current active congestion control: $current_cc"
        fi
    else
        echo "Error: delegate_cc parameter not found."
        exit 1
    fi
}


# ----------------------------------------------------------
# Print union of repo/*.ko + sysctl, deduplicated, proxy excluded
# ----------------------------------------------------------

list_one_line() {

    declare -A seen
    result=()

    for ko in "$REPO_DIR"/*.ko; do
        [ -e "$ko" ] || continue
        name=$(basename "$ko" .ko)
        [[ "$name" == "proxy" ]] && continue
        if [[ -z "${seen[$name]}" ]]; then
            seen["$name"]=1
            result+=("$name")
        fi
    done

    while read -r k; do
        [[ "$k" == "proxy" ]] && continue
        if [[ -z "${seen[$k]}" ]]; then
            seen["$k"]=1
            result+=("$k")
        fi
    done < <(sysctl -n net.ipv4.tcp_available_congestion_control \
                 | tr ' ' '\n')

    echo "${result[*]}"
}


# ----------------------------------------------------------
# List congestion controls (-ls)
# ----------------------------------------------------------

list_cc() {

    active_cc=$(get_active_cc)

    available_cc=$(sysctl -n net.ipv4.tcp_available_congestion_control)
    read -ra kernel_cc <<< "$available_cc"

    declare -A KERNEL_SET
    for k in "${kernel_cc[@]}"; do
        KERNEL_SET["$k"]=1
    done

    echo ""
    printf "%-20s | %-8s | %-7s | %-12s | %-6s\n" \
        "CC name" "built-in" "loaded" "description" "active"
    printf "%-20s-+-%-8s-+-%-7s-+-%-12s-+-%-6s\n" \
        "--------------------" "--------" "-------" "-----------" "------"

    declare -A SHOWN

    # Built-in CC first
    for cc in "${kernel_cc[@]}"; do
        [[ "$cc" == "proxy" ]] && continue
        [ -f "$REPO_DIR/$cc.ko" ] && continue
        [ -f "$REPO_DIR/$cc.c"  ] && continue
        found=$(find "$TRACES_DIR" -not -path "$REPO_DIR/*" \
                    -type f -name "$cc.c" ! -name "*.mod.c" 2>/dev/null | head -n1)
        [ -n "$found" ] && continue
        SHOWN["$cc"]=1
        marker=""
        [ "$cc" == "$active_cc" ] && marker="*"
        printf "%-20s | %-8s | %-7s | %-12s | %-6s\n" \
            "$cc" "yes" "yes" "-" "$marker"
    done

    # LLM: .ko in repo/ → loaded=yes
    for ko in "$REPO_DIR"/*.ko; do
        [ -e "$ko" ] || continue
        name=$(basename "$ko" .ko)
        [[ "$name" == *.mod ]] && continue
        SHOWN["$name"]=1
        marker=""
        [ "$name" == "$active_cc" ] && marker="*"
        printf "%-20s | %-8s | %-7s | %-12s | %-6s\n" \
            "$name" "no" "yes" "-" "$marker"
    done

    # LLM: .c in repo/ but no .ko yet (renamed or unloaded)
    for src in "$REPO_DIR"/*.c; do
        [ -e "$src" ] || continue
        name=$(basename "$src" .c)
        [[ "$name" == *.mod ]] && continue
        [ -n "${SHOWN[$name]}" ] && continue
        SHOWN["$name"]=1
        marker=""
        [ "$name" == "$active_cc" ] && marker="*"
        printf "%-20s | %-8s | %-7s | %-12s | %-6s\n" \
            "$name" "no" "no" "-" "$marker"
    done

    # LLM: .c only in traces/ subdirs (not yet in repo/)
    while IFS= read -r f; do
        name=$(basename "$f" .c)
        [[ "$name" == *.mod ]] && continue
        [ -n "${SHOWN[$name]}" ] && continue
        SHOWN["$name"]=1
        printf "%-20s | %-8s | %-7s | %-12s | %-6s\n" \
            "$name" "no" "no" "-" ""
    done < <(find "$TRACES_DIR" \
                  -not -path "$REPO_DIR/*" \
                  -type f \
                  -name "*.c" \
                  ! -name "*.mod.c" \
                  2>/dev/null)
}


# ----------------------------------------------------------
# Load congestion control module (-s)
# ----------------------------------------------------------

load_cc() {

    CC_NAME="$1"

    if [ -z "$CC_NAME" ]; then
        echo "Error: No CC name provided."
        exit 1
    fi

    if is_kernel_loaded "$CC_NAME"; then
        echo "Module $CC_NAME already loaded."
        return
    fi

    if [ -f "$REPO_DIR/$CC_NAME.ko" ]; then
        echo "Loading promoted module..."
        sudo insmod "$REPO_DIR/$CC_NAME.ko"
        echo "Module loaded: $CC_NAME"
        return
    fi

    if [ -f "$REPO_DIR/$CC_NAME.c" ]; then
        SRC="$REPO_DIR/$CC_NAME.c"
        FROM_TRACES=0
    else
        SRC=$(find "$TRACES_DIR" \
                   -not -path "$REPO_DIR/*" \
                   -type f \
                   -name "$CC_NAME.c" \
                   ! -name "*.mod.c" \
                   | head -n1)
        FROM_TRACES=1
    fi

    if [ -z "$SRC" ]; then
        echo "Error: $CC_NAME.c not found in traces or repo."
        exit 1
    fi

    if [ "$FROM_TRACES" -eq 1 ]; then
        echo "Module '$CC_NAME' is from traces/ and must be renamed before loading."
        echo "Enter new name (or press Enter to keep '$CC_NAME'):"
        read -r NEW_NAME
        NEW_NAME="${NEW_NAME:-$CC_NAME}"

        if [ "$NEW_NAME" != "$CC_NAME" ]; then
            if [ -f "$REPO_DIR/$NEW_NAME.c" ] || [ -f "$REPO_DIR/$NEW_NAME.ko" ]; then
                echo "Error: '$NEW_NAME' already exists in repo/. Choose a different name."
                exit 1
            fi
            echo "Creating renamed copy '$CC_NAME' -> '$NEW_NAME' in repo/..."
            cp "$SRC" "$REPO_DIR/$NEW_NAME.c"
            sed -i "s/\b${CC_NAME}\b/${NEW_NAME}/g" "$REPO_DIR/$NEW_NAME.c"
            echo "Original untouched: $SRC"
            CC_NAME="$NEW_NAME"
        else
            cp "$SRC" "$REPO_DIR/$CC_NAME.c"
        fi
    fi

    echo "Promoting module $CC_NAME..."

    ORIG_DIR="$(pwd)"
    cd "$REPO_DIR" || exit 1

cat > Makefile <<EOF
obj-m += ${CC_NAME}.o

all:
	make -C /lib/modules/\$(shell uname -r)/build M=\$(CURDIR) modules

clean:
	make -C /lib/modules/\$(shell uname -r)/build M=\$(CURDIR) clean
EOF

    echo "Compiling module..."

    make clean > /dev/null 2>&1
    make > /dev/null 2>&1

    if [ ! -f "$CC_NAME.ko" ]; then
        echo "Compilation failed."
        cd "$ORIG_DIR" || true
        exit 1
    fi

    echo "Loading module..."
    sudo insmod "$CC_NAME.ko"
    echo "Module loaded: $CC_NAME"

    cd "$ORIG_DIR" || true
}


# ----------------------------------------------------------
# Activate congestion control (-a)
# ----------------------------------------------------------

activate_cc() {

    CC_NAME="$1"

    if [ -z "$CC_NAME" ]; then
        echo "Error: No CC name provided."
        exit 1
    fi

    if ! is_kernel_loaded "$CC_NAME"; then

        if [ -f "$REPO_DIR/$CC_NAME.ko" ]; then
            echo "Module not loaded (reboot?). Auto-loading from repo..."
            sudo insmod "$REPO_DIR/$CC_NAME.ko"
            if ! is_kernel_loaded "$CC_NAME"; then
                echo "Error: insmod succeeded but $CC_NAME still not visible in kernel."
                exit 1
            fi
            echo "Module loaded: $CC_NAME"
        else
            echo "Error: $CC_NAME not loaded and no compiled .ko found in repo."
            echo "Use:"
            echo "  sudo cc -s $CC_NAME"
            exit 1
        fi

    fi

    echo "$CC_NAME" | sudo tee "$CC_PATH" > /dev/null
    echo "Activated congestion control: $CC_NAME"
}


# ----------------------------------------------------------
# Rename a module (-r <old> <new>)
#
# Always creates a new independent copy in repo/ with the new name,
# replacing all occurrences of the old name inside the code.
# The original is NEVER touched, NEVER unloaded, NEVER moved.
# ----------------------------------------------------------

rename_cc() {

    OLD_NAME="$1"
    NEW_NAME="$2"

    if [ -z "$OLD_NAME" ] || [ -z "$NEW_NAME" ]; then
        echo "Error: Usage: sudo cc -r <old_name> <new_name>"
        exit 1
    fi

    if [ "$OLD_NAME" == "$NEW_NAME" ]; then
        echo "Error: Old and new names are identical."
        exit 1
    fi

    if is_builtin "$OLD_NAME"; then
        echo "Error: '$OLD_NAME' is a Linux built-in module and cannot be renamed."
        exit 1
    fi

    if [ -f "$REPO_DIR/$NEW_NAME.c" ] || [ -f "$REPO_DIR/$NEW_NAME.ko" ]; then
        echo "Error: '$NEW_NAME' already exists in repo/. Choose a different name."
        exit 1
    fi

    SRC=""
    [ -f "$REPO_DIR/$OLD_NAME.c" ] && SRC="$REPO_DIR/$OLD_NAME.c"

    if [ -z "$SRC" ]; then
        SRC=$(find "$TRACES_DIR" \
                   -not -path "$REPO_DIR/*" \
                   -type f \
                   -name "$OLD_NAME.c" \
                   ! -name "*.mod.c" \
                   | head -n1)
    fi

    if [ -z "$SRC" ]; then
        echo "Error: Source file for '$OLD_NAME' not found."
        exit 1
    fi

    echo "Creating renamed copy '$OLD_NAME' -> '$NEW_NAME' in repo/..."
    cp "$SRC" "$REPO_DIR/$NEW_NAME.c"
    sed -i "s/\b${OLD_NAME}\b/${NEW_NAME}/g" "$REPO_DIR/$NEW_NAME.c"
    echo "Renamed copy stored at: $REPO_DIR/$NEW_NAME.c"
    echo "Original untouched: $SRC"
    echo "Done. '$NEW_NAME' is ready — use 'sudo cc -s $NEW_NAME' to load it."
}


# ----------------------------------------------------------
# Unload LLM congestion control module (-u)
# Removes from kernel and deletes compiled artifacts.
# Keeps the .c source file so the module can be reloaded with -s.
# ----------------------------------------------------------

unload_cc() {

    CC_NAME="$1"

    if [ -z "$CC_NAME" ]; then
        echo "Error: No CC name provided."
        exit 1
    fi

    if is_builtin "$CC_NAME"; then
        echo "Error: '$CC_NAME' is a Linux built-in module and cannot be unloaded with this command."
        exit 1
    fi

    active_cc=$(get_active_cc)
    if [ "$CC_NAME" == "$active_cc" ]; then
        echo "Error: '$CC_NAME' is currently active. Switch to another CC before unloading:"
        echo "  sudo cc -a <other_cc>"
        exit 1
    fi

    if is_kernel_loaded "$CC_NAME"; then
        echo "Unloading kernel module: $CC_NAME"
        sudo rmmod "$CC_NAME"
        if [ $? -ne 0 ]; then
            echo "Error: rmmod failed for '$CC_NAME'. The module may be in use."
            exit 1
        fi
        echo "Kernel module removed."
    else
        echo "Module '$CC_NAME' is not currently loaded in kernel (skipping rmmod)."
    fi

    echo "Removing compiled artifacts for '$CC_NAME' (keeping .c)..."

    # Explicit extensions only — .c is intentionally excluded so the source
    # is preserved and the module can be reloaded with: sudo cc -s <name>
    removed=0
    for ext in .ko .o .mod .mod.c .mod.o; do
        f="$REPO_DIR/$CC_NAME$ext"
        if [ -e "$f" ]; then
            echo "  Removing: $f"
            rm -f "$f"
            removed=1
        fi
    done
    for ext in .ko.cmd .o.cmd .mod.cmd .mod.o.cmd; do
        f="$REPO_DIR/.$CC_NAME$ext"
        if [ -e "$f" ]; then
            echo "  Removing: $f"
            rm -f "$f"
            removed=1
        fi
    done
    [ "$removed" -eq 0 ] && echo "No compiled files found for '$CC_NAME'."

    echo "Done. '$CC_NAME' unloaded — source kept at $REPO_DIR/$CC_NAME.c"
}


# ----------------------------------------------------------
# Dispatcher
# ----------------------------------------------------------

case "$1" in

    -ls)
        list_cc
        ;;

    -s)
        load_cc "$2"
        ;;

    -a)
        activate_cc "$2"
        ;;

    -r)
        rename_cc "$2" "$3"
        ;;

    -u)
        unload_cc "$2"
        ;;

    -l)
        list_one_line
        ;;

    *)
        show_current_cc
        ;;

esac